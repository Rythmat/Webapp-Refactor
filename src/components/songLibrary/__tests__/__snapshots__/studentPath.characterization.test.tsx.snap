exports[`the song page a student sees > something > header 1`] = `"<header class="relative overflow-hidden flex-shrink-0 px-6 md:px-10 py-4"><div aria-hidden="true" class="absolute inset-0 pointer-events-none" style="background: linear-gradient(180deg, rgba(210,64,74,0.12) 0%, rgba(210,64,74,0) 70%);"></div><div class="relative z-10 flex items-stretch gap-4 md:gap-5 h-36 md:h-40"><div class="flex flex-shrink-0 flex-col items-center self-start"><a class="text-xs font-medium text-white/50 transition-colors hover:text-white hover:underline" href="/learn?tab=Songs">Songs</a><button aria-label="Back to Song Library" class="w-9 h-9 flex items-center justify-center rounded-full hover:bg-white/5 transition-colors text-white/50 hover:text-white"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-left" aria-hidden="true"><path d="m15 18-6-6 6-6"></path></svg></button></div><div class="relative aspect-square h-full flex-shrink-0 overflow-hidden rounded-2xl"><img src="/artists/svg/the-beatles.webp" alt="" loading="lazy" class="absolute inset-0 size-full object-cover"></div><div class="flex h-full flex-1 flex-col justify-center gap-2 min-w-0"><h2 class="text-white truncate" style="font-family: &quot;Glacial Indifference&quot;, &quot;Fraunces&quot;, system-ui, sans-serif; font-size: clamp(1.25rem, 2vw, 1.75rem); font-weight: 600; line-height: 1.1;">“Something”</h2><p class="text-white/55 text-sm truncate">The Beatles<span class="text-white/35"> · 1969</span><span class="text-white/35"> · Written by George Harrison</span></p><div class="flex flex-col gap-2 border-t border-white/5 pt-3"><div class="flex flex-wrap items-center gap-1.5"><span class="text-[11px] uppercase tracking-wide text-white/30">Artists</span><button type="button" class="rounded-full border px-2.5 py-1 text-xs transition-colors border-white/15 text-white/75