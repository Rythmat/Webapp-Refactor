    {
      "id": "B",
      "name": "Chords",
      "steps": [
        "{"stepNumber":15,"module":"applied_theory_l1","section":"B","subsection":"B1: Arpeggiate Chords (Triads)","activity":"B1.1: Arpeggiate The 1 Chord (Out of Time)","direction":"Play the notes of Bb one at a time going up (to the right).","assessment":"pitch_only","tag":"theory_fund:arpeggio_degree1_oot | applied_theory","styleRef":"l1a","successFeedback":"Well done. You arpeggiated Bb!","chordSymbols":["Bb"],"scaleIntervals":[0,4,7]}",
        "{"stepNumber":16,"module":"applied_theory_l1","section":"B","subsection":"B1: Arpeggiate Chords (Triads)","activity":"B1.2: Arpeggiate The 1 Chord (In Time)","direction":"In a steady tempo, play an arpeggio of Bb going up and down.","assessment":"pitch_order_timing","tag":"theory_fund:arpeggio_degree1_it | applied_theory","styleRef":"l1a","successFeedback":"Well done — you arpeggiated Bb right in time.","chordSymbols":["Bb"],"scaleIntervals":[0,4,7]}",
        "{"stepNumber":17,"module":"applied_theory_l1","section":"B","subsection":"B1: Arpeggiate Chords (Triads)","activity":"B1.3: Arpeggiate The 2 Chord (Out of Time)","direction":"Play the notes of Cm one at a time going up (to the right).","assessment":"pitch_only","tag":"theory_fund:arpeggio_degree2_oot | applied_theory","styleRef":"l1a","successFeedback":"Well done. You arpeggiated Cm!","chordSymbols":["Cm"],"scaleIntervals":[2,5,9]}",
        "{"stepNumber":18,"module":"applied_theory_l1","section":"B","subsection":"B1: Arpeggiate Chords (Triads)","activity":"B1.4: Arpeggiate The 2 Chord (In Time)","direction":"In a steady tempo, play an arpeggio of Cm going up and down.","assessment":"pitch_order_timing","tag":"theory_fund:arpeggio_degree2_it | applied_theory","styleRef":"l1a","successFeedback":"Well done — you arpeggiated Cm right in time.","chordSymbols":["Cm"],"scaleIntervals":[2,5,9]}",
        "{"stepNumber":19,"module":"applied_theory_l1","section":"B","subsection":"B1: Arpeggiate Chords (Triads)","activity":"B1.5: Arpeggiate The 3 Chord (Out of Time)","direction":"Play the notes of Dm one at a time going up (to the right).","assessment":"pitch_only","tag":"theory_fund:arpeggio_degree3_oot | applied_theory","styleRef":"l1a","successFeedback":"Well done. You arpeggiated Dm!","chordSymbols":["Dm"],"scaleIntervals":[4,7,11]}",
        "{"stepNumber":20,"module":"applied_theory_l1","section":"B","subsection":"B1: Arpeggiate Chords (Triads)","activity":"B1.6: Arpeggiate The 3 Chord (In Time)","direction":"In a steady tempo, play an arpeggio of Dm going up and down.","assessment":"pitch_order_timing","tag":"theory_fund:arpeggio_degree3_it | applied_theory","styleRef":"l1a","successFeedback":"Well done — you arpeggiated Dm right in time.","chordSymbols":["Dm"],"scaleIntervals":[4,7,11]}",
        "{"stepNumber":21,"module":"applied_theory_l1","section":"B","subsection":"B1: Arpeggiate Chords (Triads)","activity":"B1.7: Arpeggiate The 4 Chord (Out of Time)","direction":"Play the notes of Eb one at a time going up (to the right).","assessment":"pitch_only","tag":"theory_fund:arpeggio_degree4_oot | applied_theory","styleRef":"l1a","successFeedback":"Well done. You arpeggiated Eb!","chordSymbols":["Eb"],"scaleIntervals":[5,9,12]}",
        "{"stepNumber":22,"module":"applied_theory_l1","section":"B","subsection":"B1: Arpeggiate Chords (Triads)","activity":"B1.8: Arpeggiate The 4 Chord (In Time)","direction":"In a steady tempo, play an arpeggio of Eb going up and down.","assessment":"pitch_order_timing","tag":"theory_fund:arpeggio_degree4_it | applied_theory","styleRef":"l1a","successFeedback":"Well done — you arpeggiated Eb right in time.","chordSymbols":["Eb"],"scaleIntervals":[5,9,12]}",
        "{"stepNumber":23,"module":"applied_theory_l1","section":"B","subsection":"B2: Play Chord (Triads)","activity":"B2.1: Play Chords 1,2,3,4 (Out of Time)","direction":"Play Bb, Cm, Dm, Eb, holding down each chord one by one.","assessment":"pitch_only","tag":"theory_fund:play_chords_oot | applied_theory","styleRef":"l1a","successFeedback":"Well done. Now play those chords in time!","chordSymbols":["Bb","Cm","Dm","Eb"],"targetNotes":[{"midi":70,"onset":0,"duration":940},{"midi":74,"onset":0,"duration":940},{"midi":77,"onset":0,"duration":940},{"midi":72,"onset":960,"duration":940},{"midi":75,"onset":960,"duration":940},{"midi":79,"onset":960,"duration":940},{"midi":74,"onset":1920,"duration":940},{"midi":77,"onset":1920,"duration":940},{"midi":81,"onset":1920,"duration":940},{"midi":75,"onset":2880,"duration":940},{"midi":79,"onset":2880,"duration":940},{"midi":82,"onset":2880,"duration":940}]}",
        "{"stepNumber":24,"module":"applied_theory_l1","section":"B","subsection":"B2: Play Chord (Triads)","activity":"B2.2: Play Chords 1,2,3,4 (Whole Notes)","direction":"In a steady tempo, play Bb, Cm, Dm, Eb in whole notes.","assessment":"pitch_order_timing_duration","tag":"theory_fund:play_chords_whole | applied_theory","styleRef":"l1a","successFeedback":"Locked in, whole notes and all — great work.","chordSymbols":["Bb","Cm","Dm","Eb"],"targetNotes":[{"midi":70,"onset":0,"duration":1900},{"midi":74,"onset":0,"duration":1900},{"midi":77,"onset":0,"duration":1900},{"midi":72,"onset":1920,"duration":1900},{"midi":75,"onset":1920,"duration":1900},{"midi":79,"onset":1920,"duration":1900},{"midi":74,"onset":3840,"duration":1900},{"midi":77,"onset":3840,"duration":1900},{"midi":81,"onset":3840,"duration":1900},{"midi":75,"onset":5760,"duration":1900},{"midi":79,"onset":5760,"duration":1900},{"midi":82,"onset":5760,"duration":1900}]}",
        "{"stepNumber":25,"module":"applied_theory_l1","section":"B","subsection":"B2: Play Chord (Triads)","activity":"B2.3: Play Chords 1,2,3,4 (Half Notes)","direction":"In a steady tempo, play Bb, Cm, Dm, Eb in half notes.","assessment":"pitch_order_timing_duration","tag":"theory_fund:play_chords_half | applied_theory","styleRef":"l1a","successFeedback":"Nice — half notes, right in time.","chordSymbols":["Bb","Cm","Dm","Eb"],"targetNotes":[{"midi":70,"onset":0,"duration":940},{"midi":74,"onset":0,"duration":940},{"midi":77,"onset":0,"duration":940},{"midi":72,"onset":960,"duration":940},{"midi":75,"onset":960,"duration":940},{"midi":79,"onset":960,"duration":940},{"midi":74,"onset":1920,"duration":940},{"midi":77,"onset":1920,"duration":940},{"midi":81,"onset":1920,"duration":940},{"midi":75,"onset":2880,"duration":940},{"midi":79,"onset":2880,"duration":940},{"midi":82,"onset":2880,"duration":940}]}",
        "{"stepNumber":26,"module":"applied_theory_l1","section":"B","subsection":"B2: Play Chord (Triads)","activity":"B2.4: Play Chords 1,2,3,4 (Quarter Notes)","direction":"In a steady tempo, play Bb, Cm, Dm, Eb in quarter notes.","assessment":"pitch_order_timing_duration","tag":"theory_fund:play_chords_quarter | applied_theory","styleRef":"l1a","successFeedback":"Quarter notes, clean and in time — great work.","chordSymbols":["Bb","Cm","Dm","Eb"],"targetNotes":[{"midi":70,"onset":0,"duration":460},{"midi":74,"onset":0,"duration":460},{"midi":77,"onset":0,"duration":460},{"midi":72,"onset":480,"duration":460},{"midi":75,"onset":480,"duration":460},{"midi":79,"onset":480,"duration":460},{"midi":74,"onset":960,"duration":460},{"midi":77,"onset":960,"duration":460},{"midi":81,"onset":960,"duration":460},{"midi":75,"onset":1440,"duration":460},{"midi":79,"onset":1440,"duration":460},{"midi":82,"onset":1440,"duration":460}]}",
        "{"stepNumber":27,"module":"applied_theory_l1","section":"B","subsection":"B3: Chord Articulations","activity":"B3.1: Two Chords (Staccato)","direction":"Play Bb, Eb in a steady tempo, with short articulations (\\"staccato\\").","assessment":"pitch_order_timing_duration","tag":"theory_fund:chord_articulation_staccato | applied_theory","styleRef":"l1a","successFeedback":"Well done. Being able to control the length of chords is an important part of mastering musical articulation!","chordSymbols":["Bb","Eb"],"targetNotes":[{"midi":70,"onset":0,"duration":120},{"midi":74,"onset":0,"duration":120},{"midi":77,"onset":0,"duration":120},{"midi":75,"onset":140,"duration":120},{"midi":79,"onset":140,"duration":120},{"midi":82,"onset":140,"duration":120}]}",
        "{"stepNumber":28,"module":"applied_theory_l1","section":"B","subsection":"B3: Chord Articulations","activity":"B3.2: Two Chords (Legato)","direction":"Play Bb, Eb in a steady tempo, with long articulations (\\"legato\\").","assessment":"pitch_order_timing_duration","tag":"theory_fund:chord_articulation_legato | applied_theory","styleRef":"l1a","successFeedback":"Well done. Now mix and match short and long articulations.","chordSymbols":["Bb","Eb"],"targetNotes":[{"midi":70,"onset":0,"duration":420},{"midi":74,"onset":0,"duration":420},{"midi":77,"onset":0,"duration":420},{"midi":75,"onset":440,"duration":420},{"midi":79,"onset":440,"duration":420},{"midi":82,"onset":440,"duration":420}]}",
