        "{"stepNumber":15,"module":"applied_theory_l1","section":"B","subsection":"B1: Arpeggiate Chords (Triads)","activity":"B1.1: Arpeggiate The 1 Chord (Out of Time)","direction":"Play the notes of F one at a time going up (to the right).","assessment":"pitch_only","tag":"theory_fund:arpeggio_degree1_oot | applied_theory","styleRef":"l1a","successFeedback":"Well done. You arpeggiated F!","chordSymbols":["F"],"scaleIntervals":[0,4,7]}",
        "{"stepNumber":16,"module":"applied_theory_l1","section":"B","subsection":"B1: Arpeggiate Chords (Triads)","activity":"B1.2: Arpeggiate The 1 Chord (In Time)","direction":"In a steady tempo, play an arpeggio of F going up and down.","assessment":"pitch_order_timing","tag":"theory_fund:arpeggio_degree1_it | applied_theory","styleRef":"l1a","successFeedback":"Well done — you arpeggiated F right in time.","chordSymbols":["F"],"scaleIntervals":[0,4,7]}",
        "{"stepNumber":17,"module":"applied_theory_l1","section":"B","subsection":"B1: Arpeggiate Chords (Triads)","activity":"B1.3: Arpeggiate The 2 Chord (Out of Time)","direction":"Play the notes of Gm one at a time going up (to the right).","assessment":"pitch_only","tag":"theory_fund:arpeggio_degree2_oot | applied_theory","styleRef":"l1a","successFeedback":"Well done. You arpeggiated Gm!","chordSymbols":["Gm"],"scaleIntervals":[2,5,9]}",
