{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  /* Every Node-side source tree. (`api/` used to be listed here too, for the
     Upstash-backed serverless functions — all of that moved into
     music-atlas-api and the directory is gone.) */
  "include": ["vite.config.ts", "scripts", ".swagger"]
}
