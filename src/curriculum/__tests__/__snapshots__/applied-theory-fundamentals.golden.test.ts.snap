      "name": "Melody",
      "steps": [
        "{"stepNumber":1,"module":"applied_theory_l1","section":"A","subsection":"A1: Major Scale","activity":"A1.1: Major Scale Ascending (Out of Time)","direction":"Play the notes of the scale going up (to the right), at your own pace.","assessment":"pitch_only","tag":"theory_fund:major_scale_ascending_oot | applied_theory","styleRef":"l1a","successFeedback":"Solid — you nailed the scale shape.","scaleIntervals":[0,2,4,5,7,9,11],"scaleId":"major"}",
        "{"stepNumber":2,"module":"applied_theory_l1","section":"A","subsection":"A1: Major Scale","activity":"A1.2: Major Scale Ascending (In Time)","direction":"In a steady tempo, play the notes of the scale going up.","assessment":"pitch_order_timing","tag":"theory_fund:major_scale_ascending_it | applied_theory","styleRef":"l1a","successFeedback":"Right in the pocket — that scale is locked in.","scaleIntervals":[0,2,4,5,7,9,11],"scaleId":"major"}",
        "{"stepNumber":3,"module":"applied_theory_l1","section":"A","subsection":"A1: Major Scale","activity":"A1.3: Major Scale Descending (Out of Time)","direction":"Play the notes of the scale going down (to the left), at your own pace.","assessment":"pitch_only","tag":"theory_fund:major_scale_descending_oot | applied_theory","styleRef":"l1a","successFeedback":"Solid — you nailed the scale shape coming down.","scaleIntervals":[0,2,4,5,7,9,11],"scaleId":"major"}",
        "{"stepNumber":4,"module":"applied_theory_l1","section":"A","subsection":"A1: Major Scale","activity":"A1.4: Major Scale Descending (In Time)","direction":"In a steady tempo, play the notes of the scale going down.","assessment":"pitch_order_timing","tag":"theory_fund:major_scale_descending_it | applied_theory","styleRef":"l1a","successFeedback":"Right in the pocket — coming down clean.","scaleIntervals":[0,2,4,5,7,9,11],"scaleId":"major"}",
        "{"stepNumber":5,"module":"applied_theory_l1","section":"A","subsection":"A1: Major Scale","activity":"A1.5: Major Scale Ascending & Descending (Out of Time)","direction":"Play the notes of the scale going up and then back down, at your own pace.","assessment":"pitch_only","tag":"theory_fund:major_scale_ascending_descending_oot | applied_theory","styleRef":"l1a","successFeedback":"You played the full scale up and down — nice work.","scaleIntervals":[0,2,4,5,7,9,11],"scaleId":"major"}",
        "{"stepNumber":6,"module":"applied_theory_l1","section":"A","subsection":"A1: Major Scale","activity":"A1.6: Major Scale Ascending & Descending (In Time)","direction":"In a steady tempo, play the notes of the scale going up and then back down.","assessment":"pitch_order_timing","tag":"theory_fund:major_scale_ascending_descending_it | applied_theory","styleRef":"l1a","successFeedback":"Full scale, up and down, right in time — great work.","scaleIntervals":[0,2,4,5,7,9,11],"scaleId":"major"}",
        "{"stepNumber":7,"module":"applied_theory_l1","section":"A","subsection":"A2: Melody","activity":"A2.1: 3 Note Contour (Out of Time)","direction":"Play this short melodic phrase, at your own pace.","assessment":"pitch_only","tag":"theory_fund:contour_a_oot | applied_theory","styleRef":"l1a","successFeedback":"Nice shape — that melodic phrase is yours now.","targetNotes":[{"midi":70,"onset":0,"duration":460},{"midi":72,"onset":480,"duration":460},{"midi":74,"onset":960,"duration":460}]}",
        "{"stepNumber":8,"module":"applied_theory_l1","section":"A","subsection":"A2: Melody","activity":"A2.2: 3 Note Contour (In Time)","direction":"In a steady tempo, play this short melodic phrase.","assessment":"pitch_order_timing","tag":"theory_fund:contour_a_it | applied_theory","styleRef":"l1a","successFeedback":"Right in time — that phrase locked in nicely.","targetNotes":[{"midi":70,"onset":0,"duration":460},{"midi":72,"onset":480,"duration":460},{"midi":74,"onset":960,"duration":460}]}",
        "{"stepNumber":9,"module":"applied_theory_l1","section":"A","subsection":"A2: Melody","activity":"A2.3: Connect Two 3 Note Contours (Out of Time)","direction":"Play this longer melodic phrase, at your own pace.","assessment":"pitch_only","tag":"theory_fund:contour_connected_oot | applied_theory","styleRef":"l1a","successFeedback":"You connected both phrases smoothly — nice work.","targetNotes":[{"midi":70,"onset":0,"duration":460},{"midi":72,"onset":480,"duration":460},{"midi":74,"onset":960,"duration":460},{"midi":74,"onset":1440,"duration":460},{"midi":72,"onset":1920,"duration":460},{"midi":70,"onset":2400,"duration":460}]}",
        "{"stepNumber":10,"module":"applied_theory_l1","section":"A","subsection":"A2: Melody","activity":"A2.4: Connect Two 3 Note Contours (In Time)","direction":"In a steady tempo, play this longer melodic phrase.","assessment":"pitch_order_timing","tag":"theory_fund:contour_connected_it | applied_theory","styleRef":"l1a","successFeedback":"Both phrases, locked in time — great work.","targetNotes":[{"midi":70,"onset":0,"duration":460},{"midi":72,"onset":480,"duration":460},{"midi":74,"onset":960,"duration":460},{"midi":74,"onset":1440,"duration":460},{"midi":72,"onset":1920,"duration":460},{"midi":70,"onset":2400,"duration":460}]}",
        "{"stepNumber":11,"module":"applied_theory_l1","section":"A","subsection":"A3: Melody Articulation","activity":"A3.1: 3 Note Contour (Staccato)","direction":"In a steady tempo, play this short melodic phrase with short, detached articulations (\\"staccato\\").","assessment":"pitch_order_timing_duration","tag":"theory_fund:contour_a_staccato | applied_theory","styleRef":"l1a","successFeedback":"Crisp and detached — that’s staccato.","targetNotes":[{"midi":70,"onset":0,"duration":120},{"midi":72,"onset":480,"duration":120},{"midi":74,"onset":960,"duration":120}]}",
        "{"stepNumber":12,"module":"applied_theory_l1","section":"A","subsection":"A3: Melody Articulation","activity":"A3.2: 3 Note Contour (Legato)","direction":"In a steady tempo, play this short melodic phrase with long, connected articulations (\\"legato\\").","assessment":"pitch_order_timing_duration","tag":"theory_fund:contour_a_legato | applied_theory","styleRef":"l1a","successFeedback":"Smooth and connected — that’s legato.","targetNotes":[{"midi":70,"onset":0,"duration":440},{"midi":72,"onset":480,"duration":440},{"midi":74,"onset":960,"duration":440}]}",
        "{"stepNumber":13,"module":"applied_theory_l1","section":"A","subsection":"A3: Melody Articulation","activity":"A3.3: 3 Note Contour (Mixed Articulation)","direction":"In a steady tempo, play this short melodic phrase with mixed articulations (staccato and legato).","assessment":"pitch_order_timing_duration","tag":"theory_fund:contour_a_mixed | applied_theory","styleRef":"l1a","successFeedback":"Nice control mixing short and long notes.","targetNotes":[{"midi":70,"onset":0,"duration":120},{"midi":72,"onset":480,"duration":440},{"midi":74,"onset":960,"duration":120}]}",
        "{"stepNumber":14,"module":"applied_theory_l1","section":"A","subsection":"A3: Melody Articulation","activity":"A3.4: Connect Two 3 Note Contours (Mixed Articulation)","direction":"In a steady tempo, play this longer melodic phrase with mixed articulations.","assessment":"pitch_order_timing_duration","tag":"theory_fund:contour_connected_mixed | applied_theory","styleRef":"l1a","successFeedback":"Great control over the full phrase, short and long notes alike.","targetNotes":[{"midi":70,"onset":0,"duration":120},{"midi":72,"onset":480,"duration":440},{"midi":74,"onset":960,"duration":120},{"midi":74,"onset":1440,"duration":440},{"midi":72,"onset":1920,"duration":120},{"midi":70,"onset":2400,"duration":440}]}",
      ],
