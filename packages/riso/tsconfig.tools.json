{
  "compilerOptions": {
    "target": "ES2022",
    /* DOM is here even though these run in Node: page.evaluate() callbacks are
       type-checked against ambient DOM types, so `window.__riso` must resolve. */
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "types": ["node"]
  },
  "include": ["tools"]
}
