# ============================================================
# Music Atlas — Environment Variables
# ============================================================
# Copy this file to .env and fill in the values.
# For Vercel deployment, add these in Project Settings → Environment Variables.
#
# NOTE: this project no longer ships any serverless functions. The `api/`
# directory (Upstash Redis-backed avatar configs, bios, streaks, connections,
# collab invites and project metadata) is gone — all of it lives in
# music-atlas-api against Postgres now. Everything below is build-time frontend
# config; there is no server-side secret in this app any more.
# ============================================================

# ── Backend API ──────────────────────────────────────────────
# Base URL of the Music Atlas backend (music-atlas-api). Every /api/* call the
# webapp makes is prefixed with this — there are no same-origin API routes.
VITE_MUSIC_ATLAS_API_URL=https://api-refactor.vercel.app/

# ── Auth0 ────────────────────────────────────────────────────
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=
VITE_AUTH0_REDIRECT_URI=

# ── PartyKit (real-time collaboration) ───────────────────────
# Deployed PartyKit host (e.g. music-atlas-collab.your-account.partykit.dev)
# Falls back to localhost:1999 for local development.
VITE_PARTYKIT_HOST=
